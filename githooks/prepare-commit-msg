#!/bin/bash

# Global hook logic
FILE=$1
MESSAGE=$(cat "$FILE")

# Try the current branch first. During a rebase, HEAD is detached, so fall back
# to the original branch name stored by git rebase.
GIT_DIR=$(git rev-parse --git-dir 2>/dev/null)
BRANCH=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)

if [[ -z "$BRANCH" && -f "$GIT_DIR/rebase-merge/head-name" ]]; then
  BRANCH=$(sed 's|^refs/heads/||' "$GIT_DIR/rebase-merge/head-name")
fi

TICKET=$(echo "$BRANCH" | grep -Eo '^(\w+/)?\w+[-_][0-9]+' | grep -Eo '\w+[-][0-9]+' | tr "[:lower:]" "[:upper:]")

if [[ -n "$TICKET" ]]; then
  if [[ "$MESSAGE" == "Merge"* ]]; then
    echo 'Merge commit, keeping git message as is.'
  elif [[ "$MESSAGE" == "$TICKET"* ]]; then
    echo 'Ticket information already present, keeping git message as is.'
  else
    # Prepend the ticket information only if conditions are met
    echo "$TICKET $MESSAGE" > "$FILE"
  fi
fi
# When no ticket can be determined (e.g. detached HEAD without rebase info),
# keep the message as is and stay silent — no need to print once per commit.

# Execute local hook if it exists
LOCAL_HOOK="$GIT_DIR/hooks/prepare-commit-msg"
if [[ -x "$LOCAL_HOOK" ]]; then
  exec "$LOCAL_HOOK" "$@"
fi
